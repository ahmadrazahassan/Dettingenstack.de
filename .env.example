# Copy to .env.local and fill in. All optional: without the mail values the forms say „wird eingerichtet“.

# Mail (Resend). Sender must be on a verified Resend domain.
RESEND_API_KEY=
LEADS_SENDER_EMAIL=noreply@dettingenstack.de
LEADS_INBOX_EMAIL=
CONTACT_INBOX_EMAIL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Plausible analytics (switches the Datenschutz text when set)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# PLAUSIBLE_EVENTS_API=https://plausible.io/api/event
